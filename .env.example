# Copy this file to .env.local and fill in the values from your Supabase
# project (Lovable Cloud) dashboard: Project Settings -> API.
# Never commit the real .env / .env.local file.

# Client-side (Vite build-time, exposed to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side (SSR / server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
